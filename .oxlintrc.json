{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    // Removing unused imports is a safe fix, so `oxlint --fix` and the
    // editor's `source.fixAll.oxc` code action strip them automatically.
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "fix": { "imports": "safe-fix", "variables": "off" }
      }
    ],
    "no-shadow": "off",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      // Primitives that receive their content through spread props.
      "files": ["src/components/ui/**"],
      "rules": {
        "jsx-a11y/heading-has-content": "off"
      }
    }
  ],
  "ignorePatterns": [".output", ".vercel", ".wrangler", "src/routeTree.gen.ts"]
}
